USE_LOCAL_STORAGE=true

# Gmail Integration (optional — for email receipt scanning)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Enable the Gmail API: https://console.cloud.google.com/apis/library/gmail.googleapis.com
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback

# Token encryption key (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
TOKEN_ENCRYPTION_KEY=